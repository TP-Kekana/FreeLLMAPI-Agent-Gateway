GATEWAY_HOSTNAME=llm.example.com
FREELLMAPI_ENCRYPTION_KEY=generate-64-hex-characters
FREELLMAPI_UNIFIED_KEY=copy-from-freellmapi-keys-page-after-first-start
FREEAPI_CONFIG_JSON={"admin":{"email":"admin@example.com","password":"change-me-now"},"routing":{"strategy":"smartest"}}

WORKER_API_KEY=generate-a-long-random-secret
PLANNER_API_KEY=generate-a-different-long-random-secret
MANAGER_API_KEY=generate-a-different-long-random-secret
UI_API_KEY=generate-a-different-long-random-secret

WORKER_MODEL=auto
PLANNER_MODEL=auto
MANAGER_MODEL=auto
UI_MODEL=auto
CORS_ORIGINS=https://your-ui.example.com
REQUEST_TIMEOUT_MS=300000
